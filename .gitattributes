# Keep text files LF on every platform so Subresource Integrity (SRI) hashes on
# vendor/*.js match the committed bytes (Windows autocrlf would break them).
* text=auto eol=lf

# Binary assets — never apply EOL conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff2 binary
*.db   binary
